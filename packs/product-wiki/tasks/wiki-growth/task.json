{
  "$schema": "../../../claudinite-tasks/task.schema.json",
  "id": "wiki-growth",
  "frequency": "weekly",
  "preconditions": [
    "repo-active",
    "no-open-pr-touching:product-wiki/"
  ],
  "agent_model": "opus",
  "expected_outcome": "pr",
  "automerge": [
    "under:product-wiki/ && doc-changes"
  ],
  "agent_execution_timeout": 2700
}
